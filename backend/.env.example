# ==============================================
# D' Bakers Backend Environment Variables
# ==============================================

# Node Environment
NODE_ENV=production

# Port (Render supplies PORT automatically; optional locally)
PORT=5000

# Allowed CORS Origins (Use '*' to allow all, or specify your Vercel URL)
# Example: https://d-bakers.vercel.app
CORS_ORIGIN=*

# Admin security PIN for dashboard & baker actions
ADMIN_PIN=1234
